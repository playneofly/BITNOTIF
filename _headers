/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/tSpeak.html
  Cache-Control: no-cache

/call.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/T.apk
  Cache-Control: public, max-age=86400

/call.html
  Permissions-Policy: camera=(self), microphone=(self), fullscreen=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()

/tSpeak.html
  Permissions-Policy: camera=(self), microphone=(self), fullscreen=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()
